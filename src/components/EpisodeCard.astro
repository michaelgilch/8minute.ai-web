---
import { withBase } from '../lib/podcast.js';

const { episode } = Astro.props;
---

<article class="episode" id={episode.slug} data-episode-number={episode.number}>
  <div class="episode-left">
    <img
      class="episode-art"
      src={withBase('/images/cover-art.jpg')}
      alt=""
      width="200"
      height="200"
      loading="lazy"
    />
    {episode.audioUrl && (
      <div class="episode-player" data-duration={episode.durationSeconds}>
        <audio controls preload="none" src={episode.audioUrl}></audio>
        <div class="player-controls">
          <button class="player-play" aria-label="Play episode">
            <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
            <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
            </svg>
          </button>
          <div class="player-time">
            <span class="time-current">0:00</span> / <span class="time-total">–:––</span>
          </div>
        </div>
        <div class="player-bar" aria-label="Seek">
          <div class="player-track">
            <div class="player-progress"></div>
          </div>
        </div>
      </div>
    )}
  </div>
  <div class="episode-main">
    <div class="episode-head">
      <div class="episode-meta">
        {episode.date}{episode.duration && ` · ${episode.duration}`}
      </div>
      <h3>{episode.title}</h3>
    </div>
    <p class="episode-excerpt">{episode.excerpt}</p>
    <div class="episode-notes" set:html={episode.notesHtml} />
  </div>
  <button
    class="episode-link"
    aria-label={`Copy link to ${episode.title}`}
    title="Copy link to this episode"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5" />
      <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5" />
    </svg>
    <span class="episode-link-copied" aria-hidden="true">Copied</span>
  </button>
  <button class="episode-toggle" aria-expanded="false" aria-label="Toggle episode details">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>
</article>

<script>
  // Toggle a card open/closed on click, except on the player, links, or the
  // show notes (so text can be selected and the audio controls used freely).
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const card = event.target.closest('.episode');
    if (!card) return;
    if (event.target.closest('a, .episode-player, .episode-notes, .episode-link')) return;
    const open = card.classList.toggle('open');
    card.querySelector('.episode-toggle')?.setAttribute('aria-expanded', String(open));
  });

  // Deep links: /episodes/#44-some-episode opens that card so the visitor only
  // has to hit play. #44 and #ep44 are accepted as shorthand for the same card.
  const findCard = (hash) => {
    const id = decodeURIComponent(hash.replace(/^#/, '')).toLowerCase();
    if (!id) return null;
    const direct = document.getElementById(id);
    if (direct?.classList.contains('episode')) return direct;
    const number = (id.match(/^(?:ep(?:isode)?[-_]?)?(\d+)$/) || [])[1];
    if (!number) return null;
    return document.querySelector(`.episode[data-episode-number="${Number(number)}"]`);
  };

  const openFromHash = (smooth) => {
    const card = findCard(window.location.hash);
    if (!card) return;
    card.classList.add('open');
    card.querySelector('.episode-toggle')?.setAttribute('aria-expanded', 'true');
    card.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
  };

  // The browser's own jump lands before the card expands, so position it here.
  openFromHash(false);

  // This module is deferred, so Chrome's scroll restoration runs after it and
  // resets us to the top; images settling also shifts the target. Re-apply once
  // on load, unless the visitor has already taken over the scroll themselves.
  let userScrolled = false;
  const markScrolled = () => {
    userScrolled = true;
  };
  window.addEventListener('wheel', markScrolled, { passive: true, once: true });
  window.addEventListener('touchmove', markScrolled, { passive: true, once: true });
  window.addEventListener('keydown', markScrolled, { once: true });
  window.addEventListener('load', () => !userScrolled && openFromHash(false), { once: true });

  window.addEventListener('hashchange', () => openFromHash(true));

  // Copy a link to this site's episode anchor (never the Podbean page).
  document.querySelectorAll('.episode-link').forEach((button) => {
    const card = button.closest('.episode');
    if (!card) return;
    button.addEventListener('click', async () => {
      const url = `${window.location.origin}${window.location.pathname}#${card.id}`;
      try {
        await navigator.clipboard.writeText(url);
        button.classList.add('copied');
        setTimeout(() => button.classList.remove('copied'), 1600);
      } catch {
        // Clipboard blocked (insecure context, denied permission): fall back to
        // putting the anchor in the address bar so it can be copied manually.
        window.location.hash = card.id;
      }
    });
  });

  // Only one episode playing at a time. The play event doesn't bubble, so
  // listen in the capture phase.
  document.addEventListener(
    'play',
    (event) => {
      if (!(event.target instanceof HTMLAudioElement)) return;
      document.querySelectorAll('audio').forEach((audio) => {
        if (audio !== event.target) audio.pause();
      });
    },
    true
  );

  // Custom player UI. The native <audio> element (hidden by CSS, visible via
  // the noscript fallback) does the actual streaming.
  const formatTime = (seconds) => {
    const s = Math.max(0, Math.round(seconds));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };

  document.querySelectorAll('.episode-player').forEach((player) => {
    const audio = player.querySelector('audio');
    const playButton = player.querySelector('.player-play');
    const currentLabel = player.querySelector('.time-current');
    const totalLabel = player.querySelector('.time-total');
    const bar = player.querySelector('.player-bar');
    const progress = player.querySelector('.player-progress');
    if (!audio || !playButton) return;

    // The feed's duration shows before any audio loads; the real metadata
    // replaces it once available.
    const duration = () =>
      Number.isFinite(audio.duration) && audio.duration > 0
        ? audio.duration
        : Number(player.dataset.duration) || 0;
    totalLabel.textContent = formatTime(duration());

    playButton.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });

    audio.addEventListener('play', () => player.classList.add('playing'));
    audio.addEventListener('pause', () => player.classList.remove('playing'));
    audio.addEventListener('loadedmetadata', () => {
      totalLabel.textContent = formatTime(duration());
    });
    audio.addEventListener('timeupdate', () => {
      currentLabel.textContent = formatTime(audio.currentTime);
      const total = duration();
      if (total) progress.style.width = `${(audio.currentTime / total) * 100}%`;
    });
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      progress.style.width = '0%';
      currentLabel.textContent = '0:00';
    });

    bar.addEventListener('click', (event) => {
      const rect = bar.getBoundingClientRect();
      const fraction = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
      const applySeek = () => {
        audio.currentTime = fraction * audio.duration;
      };
      if (audio.readyState >= 1) applySeek();
      else {
        // preload="none": metadata isn't loaded until first interaction.
        audio.addEventListener('loadedmetadata', applySeek, { once: true });
        audio.load();
      }
    });
  });
</script>
